{
  "name": "entity-publisher",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Publishes agent leaf entity configurations (self-signed JWTs) for OpenID Federation. Owns per-agent keypairs.",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "start": "tsx --env-file=.env src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "hono": "^4.6.14",
    "jose": "^5.9.6",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
