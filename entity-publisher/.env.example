# entity-publisher configuration

PORT=8092
# Public base under which agent leaf entity_ids live. entity_id = {PUBLIC_BASE_URL}/agents/<slug>
# and the leaf config is served at {entity_id}/.well-known/openid-federation (what Inmor fetches).
PUBLIC_BASE_URL=http://localhost:8092

# Trust Anchor URL (default authority_hint if the publish request omits one).
INMOR_TRUST_ANCHOR=https://localhost:8080
