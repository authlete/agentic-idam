# entity-publisher configuration

PORT=8092
# Public base under which agent leaf entity_ids live. entity_id = {PUBLIC_BASE_URL}/agents/<slug>
# and the leaf config is served at {entity_id}/.well-known/openid-federation (what resolvers fetch).
# authority_hints are supplied by the Trust Controller on each publish, so no anchor URL is needed here.
PUBLIC_BASE_URL=http://localhost:8092
