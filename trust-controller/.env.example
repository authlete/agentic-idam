# trust-controller configuration

PORT=8091
TC_BASE_URL=http://localhost:8091

# The trust-controller's own Redis (store + event bus).
# Guardrails set on the server side (see docker-compose.yml): appendonly yes, noeviction.
REDIS_URL=redis://localhost:6380
# Logical DB indices keep concerns separated.
REDIS_DB_STREAMS=1
REDIS_DB_STORE=2

# Vouch API (the control-plane API that performs the OpenID Federation work).
VOUCH_BASE_URL=http://localhost:8094
VOUCH_BEARER=replace-with-vouch-bearer-token
ANCHOR_ID=local-anchor

# The Trust Controller IS the Trust Anchor, so its entity_id defaults to TC_BASE_URL (used for
# agents' authority_hints and the /resolve trust_anchor). Set this only if the federation endpoints
# are published on a different host than the TC.
# TRUST_ANCHOR_ENTITY_ID=https://ta.example.com

# entity-publisher. Publishes agent leaf entity configs.
ENTITY_PUBLISHER_URL=http://localhost:8092

# Base URL under which agent leaf entity_ids are minted (served by entity-publisher).
AGENT_BASE_URL=http://localhost:8092/agents
