# trust-controller configuration

PORT=8091
TC_BASE_URL=http://localhost:8091

# Our own Redis (separate from Inmor's internal Redis; we only touch Inmor via its API).
# Guardrails set on the server side (see demo/docker-compose.yml): appendonly yes, noeviction.
REDIS_URL=redis://localhost:6380
# Logical DB indices keep concerns separated (issue 2A).
REDIS_DB_STREAMS=1
REDIS_DB_STORE=2

# Inmor Admin API (control/write side). The trust-controller is the SOLE caller.
INMOR_ADMIN_URL=http://localhost:8000/api/v1
INMOR_API_KEY=replace-with-inmor-api-key
# Inmor Trust Anchor (read/serve side) - used for the trust_anchor param + previews.
INMOR_TA_URL=http://localhost:8080
INMOR_TRUST_ANCHOR=http://localhost:8080

# entity-publisher (Lane 2). Publishes agent leaf entity configs.
ENTITY_PUBLISHER_URL=http://localhost:8092

# Base URL under which agent leaf entity_ids are minted (served by entity-publisher).
AGENT_BASE_URL=http://localhost:8092/agents
