{
  "name": "fed-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Federation Bridge - consumes lifecycle events, resolves trust metadata, and registers/updates/deletes the agent's OAuth client via standard DCR (RFC 7591/7592).",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "start": "tsx --env-file=.env src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "hono": "^4.6.14",
    "ioredis": "^5.4.2",
    "jose": "^6.2.4",
    "undici": "^6.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
