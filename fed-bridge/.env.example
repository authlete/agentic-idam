PORT=8093
REDIS_URL=redis://localhost:6380
REDIS_DB_STREAMS=1
REDIS_DB_STORE=4
# The Trust Controller is the Trust Anchor: one URL covers both reading the governed identity and
# resolving the trust chain. The bridge resolves at {TC_BASE_URL}/resolve.
TC_BASE_URL=http://localhost:8091
# Optional: set only if the federation endpoints are published on a different host than the TC
# (a split serve tier). Defaults to TC_BASE_URL.
# TRUST_ANCHOR_URL=https://ta.example.com
# Trust anchor's public JWKS (JSON) — REQUIRED. The bridge verifies every resolved trust chain
# against these keys and fails closed without them. Use the TA's FULL published JWKS (all keys),
# so whichever key signs the statements is matched by kid.
# TRUST_ANCHOR_JWKS={"keys":[...]}

# Standard OAuth DCR (RFC 7591) endpoint. Point at Authlete now, Ping later — same code.
DCR_REGISTRATION_ENDPOINT=http://localhost:3000/api/register
DCR_INITIAL_ACCESS_TOKEN=sample-token
# private_key_jwt = portable (Ping too). spiffe_jwt = Authlete-native (later).
DCR_TOKEN_AUTH_METHOD=private_key_jwt
